# Copy to .env for local development. Never commit a filled-in .env.
# In Coolify these live in the application's environment, not in a file.

APP_ENV=development
PORT=7777

# Direct Postgres. Inside the Coolify network the Supabase db service is reachable as `db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# PostgREST through Kong. Inside the Coolify network, `api-gw` is the Kong service alias.
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=

# Provider keys arrive in Wave 2/3. Claude Code needs its Anthropic key set to the EMPTY STRING,
# not unset, or it silently authenticates against Anthropic directly and you lose model control.
OPENROUTER_API_KEY=
# Slack command center: Socket Mode needs BOTH (bot posts, app-level holds the websocket).
# Without them the API serves normally and the listener simply stays off.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
